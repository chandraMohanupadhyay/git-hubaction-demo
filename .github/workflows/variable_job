name: variable_job

on:
  workflow_dispatch:

# Global variables
env:
  APP_NAME: Nginx
  ENVIRONMENT: dev

jobs:
  variable_job:
    runs-on: ubuntu-latest

    # Job-level variables
    env:
      getting: Hello

    steps:
      - uses: actions/checkout@v4

      - name: New app
        run: |
          echo "$getting This is the new $APP_NAME app in the environment $ENVIRONMENT."
